rules_version = '2';

// Storage rules — 06 §3.2.
//
// Two buckets' worth of content, both public-read: the resume a recruiter
// downloads and the screenshots on the case studies. Neither is secret; both
// are useless if a visitor cannot fetch them.
//
// Writes are admin-only, matching firestore.rules and 05 §1.
service firebase.storage {
  match /b/{bucket}/o {

    function isAdmin() {
      return request.auth != null;
    }

    // Current resume file, referenced by Profile.resumeFile so it can be
    // replaced without a redeploy (04 §2).
    match /resume/{file} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Per-project media, mirroring the local folder structure (06 §3.2).
    match /projects/{slug}/{file} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
